# Resend API Key for sending emails from the contact form
RESEND_API_KEY=re_your_api_key_here

# Recipient email address for contact form inquiries (defaults to ipr@iprani.com if omitted)
CONTACT_RECEIVER_EMAIL=ipr@iprani.com

# Verified sender email in Resend (optional: defaults to onboarding@resend.dev until custom domain is verified)
# FROM_EMAIL=IP Rani <contact@iprani.com>
